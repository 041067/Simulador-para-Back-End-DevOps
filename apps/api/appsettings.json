{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=backops;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Observability": {
    "ServiceName": "backops-api",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Resilience": {
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "SuccessThreshold": 2,
      "TimeoutSeconds": 30
    },
    "Retry": {
      "MaxRetries": 3,
      "BaseDelayMs": 100,
      "Multiplier": 2.0,
      "JitterMs": 100
    }
  },
  "Seq": {
    "Url": "http://localhost:5341"
  }
}