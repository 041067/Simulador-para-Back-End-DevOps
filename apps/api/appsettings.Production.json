{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Observability": {
    "ServiceName": "backops-api",
    "OtlpEndpoint": ""
  },
  "Resilience": {
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "SuccessThreshold": 2,
      "TimeoutSeconds": 30
    },
    "Retry": {
      "MaxRetries": 3,
      "BaseDelayMs": 100,
      "Multiplier": 2.0,
      "JitterMs": 100
    }
  },
  "Seq": {
    "Url": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://backops-simulator.vercel.app"
    ]
  }
}